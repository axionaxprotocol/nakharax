# Nakhara OS Dashboard — production (EU VPS 217.216.109.5)
# Copy to .env.production before `pnpm build`

NODE_ENV=production

# Chain / RPC (public endpoints on AU — 46.250.244.4)
NEXT_PUBLIC_CHAIN_ID=86137
NEXT_PUBLIC_RPC_URL=https://rpc.nakhara.io

# Optional: direct validator fallbacks for node monitor
NEXT_PUBLIC_RPC_EU=http://217.216.109.5:8545
NEXT_PUBLIC_RPC_AU=http://46.250.244.4:8545

# Propsentinel (if running on AU docker-compose root stack)
NEXT_PUBLIC_PROPSENTINEL_URL=https://api.nakhara.io

# Server listen port (PM2 / next start)
PORT=3030
