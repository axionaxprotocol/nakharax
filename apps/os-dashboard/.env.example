# Nakharax OS Dashboard — production
# Copy to .env.production before `pnpm build`

NODE_ENV=production

# Chain / RPC (public HTTPS RPC)
NEXT_PUBLIC_CHAIN_ID=86137
NEXT_PUBLIC_RPC_URL=https://rpc.nakharax.com

# Optional: direct validator fallbacks for node monitor
NEXT_PUBLIC_RPC_EU=https://rpc.nakharax.com
NEXT_PUBLIC_RPC_AU=https://rpc.nakharax.com

# Server listen port (PM2 / next start)
PORT=3030
