[Unit]
Description=Write NakharaX node systemd health metrics
After=nakharax-node.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/nakharax-monitoring-agent.env
ExecStart=/usr/local/libexec/nakharax-node-service-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/nakharax-node-exporter/textfile
