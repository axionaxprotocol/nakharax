global:
  resolve_timeout: 5m

route:
  receiver: nakharax-operations-webhook
  group_by: [alertname, node, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: nakharax-operations-webhook
    webhook_configs:
      - url: "__ALERT_WEBHOOK_URL__"
        send_resolved: true
