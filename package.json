{
  "name": "nakharax",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter nakharax-os-dashboard dev",
    "dev:all": "node scripts/dev.mjs",
    "build": "pnpm --filter @nakharax/contracts compile && pnpm --filter @nakharax/sdk build && pnpm --filter nakharax-os-dashboard build",
    "typecheck": "pnpm --filter @nakharax/sdk typecheck",
    "mock-rpc": "node services/core/ops/deploy/mock-rpc/server.js",
    "test": "pnpm --filter @nakharax/contracts test",
    "test:all": "pnpm test && cd services/core/core && cargo test --workspace --all-features",
    "ci": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1",
    "ci:quick": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Quick",
    "ci:bash": "bash scripts/ci-local.sh",
    "testnet:simulate": "node scripts/simulate_live_testnet.mjs",
    "worker": "python services/core/deai/worker_daemon.py",
    "reality:check": "python scripts/reality_check.py",
    "contracts:compile": "pnpm --filter @nakharax/contracts compile",
    "contracts:test": "pnpm --filter @nakharax/contracts test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.10"
  }
}