{
  "name": "@nakharax/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed JSON-RPC client + shared chain primitives for Nakharax Protocol.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
